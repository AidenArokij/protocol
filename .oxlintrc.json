{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-hooks",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-console": [
      "error",
      {
        "allow": [
          "error",
          "warn"
        ]
      }
    ],
    "vitest/require-mock-type-parameters": "off",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": [
    "dist",
    "src-tauri",
    "node_modules"
  ],
  "overrides": [
    {
      "files": [
        "src/importer/cli.ts",
        "scripts/**"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
