{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ПРОТОКОЛ",
  "mainBinaryName": "protocol",
  "version": "../package.json",
  "identifier": "com.aidenarokij.protocol",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ПРОТОКОЛ",
        "width": 600,
        "height": 900,
        "minWidth": 420,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "AidenArokij",
    "copyright": "© 2026 AidenArokij; основано на РО Хелпер © 2026 skyze",
    "category": "Utility",
    "shortDescription": "Законы Russia Online поверх игры и ИИ-разбор ситуаций",
    "longDescription": "Законы, уставы и правила серверов Russia Online в окне поверх игры: поиск, ИИ-разбор ситуации по законам сервера, калькулятор срока и штрафа, закреплённые карточки.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RkUzN0YwMDY5NDlDNDEKUldSQm5KUUc4RGYrT0dHZFlXSFpyWi8rWHhKaGhTQWhBb2NjWmQzY2ptdnJjdy9BUzEzV1NDcVcK",
      "endpoints": [
        "https://github.com/AidenArokij/protocol/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
