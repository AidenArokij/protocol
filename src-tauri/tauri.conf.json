{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROTOCOL",
  "version": "1.0.0",
  "identifier": "online.russia.protocol",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ПРОТОКОЛ  (F9 — показать/спрятать)",
        "width": 920,
        "height": 880,
        "minWidth": 480,
        "minHeight": 400,
        "alwaysOnTop": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"]
      }
    }
  }
}
