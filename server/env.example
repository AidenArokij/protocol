# ПРОТОКОЛ AI server settings. The real file is /opt/protocol/.env on the server; the key goes there only
# (bash /opt/protocol/set-key.sh asks for it). Change the rest with `nano /opt/protocol/.env`,
# then `systemctl restart protocol-ai`.

# The OpenAI-compatible AI API and its key (ProxyAPI by default).
AI_BASE_URL=https://api.proxyapi.ru/openai/v1
AI_API_KEY=
AI_MODEL=gpt-5-nano
AI_TRANSCRIBE_MODEL=whisper-1

# Prices of the model in rubles per 1M tokens (in / out) and per minute of speech — for counting the budget.
PRICE_IN_RUB=13
PRICE_OUT_RUB=104
PRICE_MINUTE_RUB=1.6

# Budget for everyone together, rubles a day (~600 ₽ a month at 20).
BUDGET_RUB_PER_DAY=20

# Limits per computer and per internet address, a day.
QUESTIONS_PER_DEVICE=20
VOICE_PER_DEVICE=10
REQUESTS_PER_IP=80
